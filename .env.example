# Google Cloud OAuth client (Web application type)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Optional fallback Gemini key (aistudio.google.com/apikey), used only if
# no key has been saved via the in-app Settings (⚙) modal. Unrelated to
# the OAuth client above. Leave blank if every user will bring their own
# key through Settings instead.
GEMINI_API_KEY=

PORT=3000
